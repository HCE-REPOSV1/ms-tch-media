# ms-media-media-service — Environment Variables

PORT=10406
NODE_ENV=development

# SSL — certificados
# CERT_PATH:       ruta dentro del contenedor (o ruta local si corres sin Docker en Windows)
# CERTS_HOST_PATH: ruta en el HOST que Docker monta como CERT_PATH (solo lee docker-compose.dev.yml)
USE_SSL=true
SSL_PORT=20406
CERT_PATH=/app/certs
CERTS_HOST_PATH=../certs-dev

# Media files
# MEDIA_PATH:       ruta donde el servicio accede a los archivos (dentro del contenedor, o ruta local Windows)
# MEDIA_HOST_PATH:  ruta en el HOST que Docker monta como /proyectos/NEW_HCE/MEDIA (solo lee docker-compose.dev.yml)
MEDIA_PATH=/dev-media
MEDIA_HOST_PATH=./dev-media

# Database (SQL Server)
DB_HOST=host.docker.internal
DB_PORT=1433
DB_USER=claude_mssql
DB_PASS=1234
DB_NAME=HCE_CORE_V2
# DB_INSTANCE vacío: instancia local es SQLEXPRESS (no INST01, default del código), SQL Browser detenido.
DB_INSTANCE=

# Uploads temporales (multer)
UPLOADS_DIR=./uploads

# Tamaño máximo por archivo en MB
MAX_FILE_SIZE_MB=50

# MIME types permitidos separados por coma (vacío = todos)
ALLOWED_TYPES=

# Kafka Logger
AUDIT_LOGGER_ENABLED=true
KAFKA_BROKER=host.docker.internal:10403
KAFKA_TOPIC=platform.logs
