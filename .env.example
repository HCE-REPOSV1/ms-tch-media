# ms-tch-media — Environment Variables
# Generated by Jarvis Platform

PORT=
NODE_ENV=

# Directorio donde se almacenan los archivos subidos
UPLOADS_DIR=

# Tamaño máximo por archivo en MB
MAX_FILE_SIZE_MB=

# MIME types permitidos separados por coma (vacío = todos)
# Ejemplo: image/jpeg,image/png,application/pdf
ALLOWED_TYPES=

# Kafka Logger
# AUDIT_LOGGER_ENABLED=false desactiva el audit logger por completo (no-op, sin Kafka)
# Default: true
AUDIT_LOGGER_ENABLED=true
KAFKA_BROKER=
KAFKA_TOPIC=
